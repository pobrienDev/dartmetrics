# Copy this file to .env and adjust values. .env is git-ignored — real
# secrets never enter the repository.

# PostgreSQL container credentials (development defaults)
POSTGRES_USER=dartmetrics
POSTGRES_PASSWORD=dartmetrics_dev
POSTGRES_DB=dartmetrics

# Connection string the backend and Alembic use
DATABASE_URL=postgresql+psycopg://dartmetrics:dartmetrics_dev@localhost:5432/dartmetrics

# Optional: reuse a data volume created under a different Compose
# project name (defaults to dartmetrics_pgdata's standard name)
# PGDATA_VOLUME=dartmetrics_pgdata

# JWT signing key - generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-generate-a-real-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser origins allowed to call the API from a different host,
# comma-separated. Leave empty when the frontend is served from the same
# origin as the API (the dev proxy does this).
CORS_ORIGINS=

# Login/register attempts allowed per client IP (slowapi notation)
AUTH_RATE_LIMIT=10/minute

# Production container only (set by the Dockerfile): directory of the
# built frontend that the API serves alongside /api. Leave unset in
# development, where the Vite dev server serves the app.
# STATIC_DIR=/app/static

# Container entrypoint: set to 0 to skip "alembic upgrade head" on start
# when the platform runs migrations in its own deploy step.
# RUN_MIGRATIONS=1
