# Copy this file to .env and adjust values. .env is git-ignored — real
# secrets never enter the repository.

# PostgreSQL container credentials (development defaults)
POSTGRES_USER=dartmetrics
POSTGRES_PASSWORD=dartmetrics_dev
POSTGRES_DB=dartmetrics

# Connection string the backend and Alembic use
DATABASE_URL=postgresql+psycopg://dartmetrics:dartmetrics_dev@localhost:5432/dartmetrics
